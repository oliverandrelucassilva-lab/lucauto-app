# Copie para .env.local e preencha. NUNCA coloque valores reais neste arquivo nem no repositório.

# ---- Entrada no sistema ----
# mock     = login de teste (só desenvolvimento; é recusado em produção)
# supabase = login real por pessoa (e-mail e senha), com convite por e-mail
AUTH_MODE=mock
# Obrigatório em produção para o modo mock; no modo supabase não é usado. 16+ caracteres.
SESSION_SECRET=

# ---- Supabase (projeto NOVO, em nome da Lucauto) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Conversão para PDF ----
# libreoffice = usa o LibreOffice da máquina (desenvolvimento)
# gotenberg   = serviço próprio de conversão (produção; funções serverless não rodam LibreOffice)
PDF_CONVERSOR=libreoffice
# LIBREOFFICE_BIN=soffice
# GOTENBERG_URL=

# ---- Dados da empresa nos contratos ----
# Enquanto estiverem vazios, saem como [A CONFIRMAR] no contrato. Nunca inventar.
EMPRESA_CNPJ=
EMPRESA_CRECI_JURIDICO=
EMPRESA_CORRETORA_NOME=
EMPRESA_CORRETORA_CRECI=
